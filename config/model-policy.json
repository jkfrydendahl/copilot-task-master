{
  "schemaVersion": 2,
  "denylist": [
    "claude-fable-5"
  ],
  "familyPatterns": {
    "sonnet-family": "claude-sonnet-\\d",
    "haiku-family": "claude-haiku-\\d",
    "opus-family": "claude-opus-\\d",
    "fable-family": "claude-fable-\\d",
    "codex-family": "gpt-.*-codex",
    "mini-family": "gpt-.*-mini",
    "gpt-flagship-family": "gpt-5\\.\\d+$",
    "gpt-sol-family": "gpt-5\\.\\d+-sol$",
    "gpt-terra-family": "gpt-5\\.\\d+-terra$",
    "gpt-luna-family": "gpt-5\\.\\d+-luna$",
    "mai-family": "mai-[\\w.\\-]+"
  },
  "classPreferences": {
    "orchestrator": ["sonnet-family", "gpt-terra-family", "gpt-flagship-family"],
    "quick": ["haiku-family", "mai-family", "gpt-luna-family", "mini-family"],
    "default-development": ["sonnet-family", "gpt-terra-family", "gpt-flagship-family"],
    "agentic-implementation": ["fable-family", "codex-family", "gpt-terra-family", "gpt-flagship-family", "sonnet-family"],
    "deep-reasoning": ["opus-family", "gpt-sol-family", "gpt-flagship-family"],
    "review": ["sonnet-family", "gpt-terra-family", "codex-family"],
    "visual-ui": ["sonnet-family", "gpt-terra-family", "gpt-flagship-family"],
    "mechanical": ["haiku-family", "mai-family", "gpt-luna-family", "mini-family"],
    "triage": ["sonnet-family", "mai-family", "gpt-luna-family", "mini-family"]
  },
  "profileLiveBenchCategories": {
    "agentic-implementation": "agenticCoding",
    "deep-reasoning": "reasoning",
    "orchestrator": "instructionFollowing",
    "triage": "instructionFollowing",
    "default-development": "coding",
    "review": "reasoning",
    "visual-ui": "coding",
    "quick": "coding",
    "mechanical": "coding"
  },
  "profileArtificialAnalysisMetrics": {
    "agentic-implementation": "coding",
    "default-development": "coding",
    "visual-ui": "coding",
    "quick": "coding",
    "mechanical": "coding",
    "orchestrator": "intelligence",
    "triage": "intelligence",
    "deep-reasoning": "intelligence",
    "review": "intelligence"
  },
  "profileRequirements": {
    "quick": { "inputCeilingPerMillion": 2, "outputCeilingPerMillion": 10, "requiresVision": false, "requiresCliAgent": true, "costSensitive": true },
    "mechanical": { "inputCeilingPerMillion": 2, "outputCeilingPerMillion": 10, "requiresVision": false, "requiresCliAgent": true, "costSensitive": true },
    "triage": { "inputCeilingPerMillion": 2, "outputCeilingPerMillion": 10, "requiresVision": false, "requiresCliAgent": true, "costSensitive": true },
    "default-development": { "inputCeilingPerMillion": 3, "outputCeilingPerMillion": 15, "requiresVision": false, "requiresCliAgent": true, "costSensitive": false },
    "orchestrator": { "inputCeilingPerMillion": 3, "outputCeilingPerMillion": 15, "requiresVision": false, "requiresCliAgent": true, "costSensitive": false },
    "visual-ui": { "inputCeilingPerMillion": 3, "outputCeilingPerMillion": 15, "requiresVision": true, "requiresCliAgent": true, "costSensitive": false },
    "review": { "inputCeilingPerMillion": 5, "outputCeilingPerMillion": 30, "requiresVision": false, "requiresCliAgent": true, "costSensitive": false },
    "agentic-implementation": { "inputCeilingPerMillion": 10, "outputCeilingPerMillion": 50, "requiresVision": false, "requiresCliAgent": true, "costSensitive": false },
    "deep-reasoning": { "inputCeilingPerMillion": 10, "outputCeilingPerMillion": 45, "requiresVision": false, "requiresCliAgent": true, "costSensitive": false }
  },
  "consensusPolicy": {
    "staleAfterDays": 45,
    "capabilityFreshnessDays": 60,
    "pricingFreshnessDays": 45,
    "benchmarkMaxPublicationAgeDays": 90
  },
  "selectionPolicy": {
    "version": 2,
    "referenceInputTokens": 1000000,
    "referenceOutputTokens": 100000,
    "referenceUsageDescription": "Aggregate uncached usage across requests within the selected context tier, not a single 1M-token request or predicted task cost. Cache reads/writes are excluded.",
    "profiles": {
      "orchestrator": {
        "strategy": "value_balanced",
        "qualityBands": { "artificialAnalysis.intelligenceIndex": 3, "liveBench.instructionFollowing": 3 }
      },
      "quick": {
        "strategy": "value_balanced",
        "qualityBands": { "artificialAnalysis.codingIndex": 3, "liveBench.coding": 3 }
      },
      "mechanical": {
        "strategy": "value_balanced",
        "qualityBands": { "artificialAnalysis.codingIndex": 3, "liveBench.coding": 3 }
      },
      "triage": {
        "strategy": "value_balanced",
        "qualityBands": { "artificialAnalysis.intelligenceIndex": 3, "liveBench.instructionFollowing": 3 }
      },
      "default-development": { "strategy": "quality_first" },
      "agentic-implementation": { "strategy": "quality_first" },
      "deep-reasoning": { "strategy": "quality_first" },
      "review": { "strategy": "quality_first" },
      "visual-ui": { "strategy": "quality_first" }
    }
  }
}
