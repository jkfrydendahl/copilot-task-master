{
  "schemaVersion": 4,
  "denylist": [
    "claude-fable-5"
  ],
  "familyPatterns": {
    "sonnet-family": "claude-sonnet-\\d",
    "haiku-family": "claude-haiku-\\d",
    "opus-family": "claude-opus-\\d",
    "fable-family": "claude-fable-\\d",
    "codex-family": "gpt-.*-codex",
    "mini-family": "gpt-.*-mini",
    "gpt-flagship-family": "gpt-5\\.\\d+$",
    "gpt-sol-family": "gpt-5\\.\\d+-sol$",
    "gpt-terra-family": "gpt-5\\.\\d+-terra$",
    "gpt-luna-family": "gpt-5\\.\\d+-luna$",
    "mai-family": "mai-[\\w.\\-]+"
  },
  "classPreferences": {
    "orchestrator": ["sonnet-family", "gpt-terra-family", "gpt-flagship-family"],
    "quick": ["haiku-family", "mai-family", "gpt-luna-family", "mini-family"],
    "default-development": ["sonnet-family", "gpt-terra-family", "gpt-flagship-family"],
    "agentic-implementation": ["fable-family", "codex-family", "gpt-terra-family", "gpt-flagship-family", "sonnet-family"],
    "deep-reasoning": ["opus-family", "gpt-sol-family", "gpt-flagship-family"],
    "review": ["sonnet-family", "gpt-terra-family", "codex-family"],
    "visual-ui": ["sonnet-family", "gpt-terra-family", "gpt-flagship-family"],
    "mechanical": ["haiku-family", "mai-family", "gpt-luna-family", "mini-family"],
    "triage": ["sonnet-family", "mai-family", "gpt-luna-family", "mini-family"]
  },
  "evidenceMetrics": {
    "artificialAnalysis.codingIndex": { "source": "artificialAnalysis", "metric": "codingIndex", "label": "AA Coding Index", "min": 0, "max": 100, "scale": "index points", "lineage": ["aa-coding"], "limitation": "Coding aggregate; not direct evidence of review or UI implementation quality." },
    "artificialAnalysis.intelligenceIndex": { "source": "artificialAnalysis", "metric": "intelligenceIndex", "label": "AA Intelligence Index", "min": 0, "max": 100, "scale": "index points", "lineage": ["aa-intelligence", "automationbench-aa", "aa-lcr"], "limitation": "General reasoning proxy; overlaps component benchmarks, not independent corroboration." },
    "artificialAnalysisCodingAgents.codingAgentIndex": { "source": "artificialAnalysisCodingAgents", "metric": "codingAgentIndex", "label": "AA Coding Agent Index", "min": 0, "max": 1, "scale": "fraction", "lineage": ["aa-coding-agents"], "limitation": "External coding-agent harness, not Copilot CLI." },
    "liveBench.coding": { "source": "liveBench", "metric": "coding", "label": "LiveBench Coding", "min": 0, "max": 100, "scale": "percentage points", "lineage": ["livebench-coding"], "limitation": "Coding proxy, not direct review or UI implementation evidence." },
    "liveBench.agenticCoding": { "source": "liveBench", "metric": "agenticCoding", "label": "LiveBench Agentic Coding", "min": 0, "max": 100, "scale": "percentage points", "lineage": ["livebench-agentic"], "limitation": "External agentic coding evaluation, not the local orchestration workflow." },
    "liveBench.reasoning": { "source": "liveBench", "metric": "reasoning", "label": "LiveBench Reasoning", "min": 0, "max": 100, "scale": "percentage points", "lineage": ["livebench-reasoning"], "limitation": "Reasoning proxy; does not establish interactive triage skill." },
    "liveBench.instructionFollowing": { "source": "liveBench", "metric": "instructionFollowing", "label": "LiveBench Instruction Following", "min": 0, "max": 100, "scale": "percentage points", "lineage": ["livebench-if"], "limitation": "Instruction following, not end-to-end workflow completion." },
    "artificialAnalysisComponents.automationBench": { "source": "artificialAnalysisComponents", "metric": "automationBench", "label": "AutomationBench-AA", "min": 0, "max": 1, "scale": "guardrail-adjusted objective fraction", "lineage": ["automationbench-aa"], "limitation": "Workflow/tool-use proxy; clarifying questions prohibited. Not interactive orchestration or conversation-memory evidence." },
    "artificialAnalysisComponents.enterpriseOpsGym": { "source": "artificialAnalysisComponents", "metric": "enterpriseOpsGym", "label": "EnterpriseOps-Gym-AA", "min": 0, "max": 1, "scale": "strict pass@1 fraction", "lineage": ["enterpriseops-aa"], "limitation": "AA oracle-tool workflow harness; tools supplied. Not tool-discovery evidence or the original paper's scores." },
    "artificialAnalysisComponents.ifbench": { "source": "artificialAnalysisComponents", "metric": "ifbench", "label": "IFBench (AA)", "min": 0, "max": 1, "scale": "accuracy fraction", "lineage": ["ifbench-aa"], "limitation": "Single-turn instruction following, not multi-turn retention." },
    "artificialAnalysisComponents.lcr": { "source": "artificialAnalysisComponents", "metric": "lcr", "label": "AA-LCR", "min": 0, "max": 1, "scale": "accuracy fraction", "lineage": ["aa-lcr"], "limitation": "Long-document reasoning, not conversational retention." },
    "artificialAnalysisComponents.mmmuPro": { "source": "artificialAnalysisComponents", "metric": "mmmuPro", "label": "MMMU Pro (AA)", "min": 0, "max": 1, "scale": "accuracy fraction", "lineage": ["mmmu-pro-aa"], "limitation": "Visual understanding, not UI implementation fidelity." }
  },
  "profileRequirements": {
    "quick": { "inputCeilingPerMillion": 2, "outputCeilingPerMillion": 10, "requiresVision": false, "requiresCliAgent": true, "costSensitive": true },
    "mechanical": { "inputCeilingPerMillion": 2, "outputCeilingPerMillion": 10, "requiresVision": false, "requiresCliAgent": true, "costSensitive": true },
    "triage": { "inputCeilingPerMillion": 2, "outputCeilingPerMillion": 10, "requiresVision": false, "requiresCliAgent": true, "costSensitive": true },
    "default-development": { "inputCeilingPerMillion": 4, "outputCeilingPerMillion": 20, "requiresVision": false, "requiresCliAgent": true, "costSensitive": true },
    "orchestrator": { "inputCeilingPerMillion": 3, "outputCeilingPerMillion": 15, "requiresVision": false, "requiresCliAgent": true, "costSensitive": true },
    "visual-ui": { "inputCeilingPerMillion": 5, "outputCeilingPerMillion": 25, "requiresVision": true, "requiresCliAgent": true, "costSensitive": true },
    "review": { "inputCeilingPerMillion": 5, "outputCeilingPerMillion": 30, "requiresVision": false, "requiresCliAgent": true, "costSensitive": true },
    "agentic-implementation": { "inputCeilingPerMillion": 10, "outputCeilingPerMillion": 50, "requiresVision": false, "requiresCliAgent": true, "costSensitive": true },
    "deep-reasoning": { "inputCeilingPerMillion": 10, "outputCeilingPerMillion": 45, "requiresVision": false, "requiresCliAgent": true, "costSensitive": true }
  },
  "consensusPolicy": {
    "discoveryFreshnessDays": 7,
    "staleAfterDays": 45,
    "capabilityFreshnessDays": 60,
    "pricingFreshnessDays": 45,
    "benchmarkMaxPublicationAgeDays": 90
  },
  "selectionPolicy": {
    "version": 12,
    "costTieBreak": "newest_verified_release",
    "referenceInputTokens": 1000000,
    "referenceOutputTokens": 100000,
    "referenceUsageDescription": "Aggregate uncached usage across requests within the selected context tier, not a single 1M-token request or predicted task cost. Cache reads/writes are excluded.",
    "profiles": {
      "orchestrator": {
        "strategy": "value_balanced",
        "evidenceRoutes": ["artificialAnalysisComponents.automationBench", "artificialAnalysisComponents.enterpriseOpsGym"],
        "supportingMetrics": [],
        "qualification": {
          "minimumModels": 2,
          "dimensions": [
            { "key": "long-context", "evidenceRoutes": ["artificialAnalysisComponents.lcr"], "qualityBands": { "artificialAnalysisComponents.lcr": 0.05 } },
            { "key": "instruction-following", "evidenceRoutes": ["liveBench.instructionFollowing", "artificialAnalysisComponents.ifbench"], "qualityBands": { "artificialAnalysisComponents.ifbench": 0.03, "liveBench.instructionFollowing": 3 } }
          ]
        },
        "configurationSelection": { "mode": "bounded_effort", "allowedEfforts": ["high"], "effortChangePolicy": "automatic" },
        "qualityBands": { "artificialAnalysisComponents.automationBench": 0.03, "artificialAnalysisComponents.enterpriseOpsGym": 0.03 }
      },
      "quick": {
        "strategy": "value_balanced",
        "evidenceRoutes": ["artificialAnalysis.codingIndex", "liveBench.coding"],
        "supportingMetrics": ["artificialAnalysisComponents.ifbench", "liveBench.instructionFollowing"],
        "qualification": { "minimumModels": 2, "dimensions": [] },
        "configurationSelection": { "mode": "bounded_effort", "allowedEfforts": ["low"], "effortChangePolicy": "automatic" },
        "qualityBands": { "artificialAnalysis.codingIndex": 3, "liveBench.coding": 3 }
      },
      "mechanical": {
        "strategy": "value_balanced",
        "evidenceRoutes": ["artificialAnalysisComponents.automationBench", "artificialAnalysisComponents.enterpriseOpsGym"],
        "supportingMetrics": [],
        "qualification": {
          "minimumModels": 2,
          "dimensions": [
            { "key": "instruction-following", "evidenceRoutes": ["artificialAnalysisComponents.ifbench", "liveBench.instructionFollowing"], "qualityBands": { "artificialAnalysisComponents.ifbench": 0.03, "liveBench.instructionFollowing": 3 } }
          ]
        },
        "configurationSelection": { "mode": "bounded_effort", "allowedEfforts": ["low"], "effortChangePolicy": "automatic" },
        "qualityBands": { "artificialAnalysisComponents.automationBench": 0, "artificialAnalysisComponents.enterpriseOpsGym": 0 }
      },
      "triage": {
        "strategy": "value_balanced",
        "evidenceRoutes": ["artificialAnalysis.intelligenceIndex", "liveBench.reasoning"],
        "supportingMetrics": [],
        "qualification": {
          "minimumModels": 2,
          "dimensions": [
            { "key": "instruction-following", "evidenceRoutes": ["artificialAnalysisComponents.ifbench", "liveBench.instructionFollowing"], "qualityBands": { "artificialAnalysisComponents.ifbench": 0.03, "liveBench.instructionFollowing": 3 } }
          ]
        },
        "configurationSelection": { "mode": "bounded_effort", "allowedEfforts": ["low"], "effortChangePolicy": "automatic" },
        "qualityBands": { "artificialAnalysis.intelligenceIndex": 3, "liveBench.reasoning": 3 }
      },
      "default-development": {
        "strategy": "value_balanced",
        "evidenceRoutes": ["artificialAnalysis.codingIndex", "liveBench.coding"],
        "supportingMetrics": [],
        "qualification": {
          "minimumModels": 2,
          "dimensions": [
            { "key": "instruction-following", "evidenceRoutes": ["liveBench.instructionFollowing", "artificialAnalysisComponents.ifbench"], "qualityBands": { "artificialAnalysisComponents.ifbench": 0.03, "liveBench.instructionFollowing": 3 } }
          ]
        },
        "configurationSelection": { "mode": "bounded_effort", "allowedEfforts": ["medium", "high"], "effortChangePolicy": "automatic" },
        "qualityBands": { "artificialAnalysis.codingIndex": 3, "liveBench.coding": 3 }
      },
      "agentic-implementation": {
        "strategy": "value_balanced",
        "evidenceRoutes": ["artificialAnalysisCodingAgents.codingAgentIndex", "liveBench.agenticCoding"],
        "supportingMetrics": ["artificialAnalysisComponents.automationBench", "artificialAnalysisComponents.enterpriseOpsGym"],
        "qualification": { "minimumModels": 2, "dimensions": [] },
        "configurationSelection": {
          "mode": "bounded_effort",
          "allowedEfforts": ["high", "xhigh", "max"],
          "effortChangePolicy": "automatic"
        },
        "qualityBands": { "artificialAnalysisCodingAgents.codingAgentIndex": 0.03, "liveBench.agenticCoding": 3 }
      },
      "deep-reasoning": {
        "strategy": "value_balanced",
        "evidenceRoutes": ["artificialAnalysis.intelligenceIndex", "liveBench.reasoning"],
        "supportingMetrics": [],
        "qualification": {
          "minimumModels": 2,
          "dimensions": [
            { "key": "long-context", "evidenceRoutes": ["artificialAnalysisComponents.lcr"], "qualityBands": { "artificialAnalysisComponents.lcr": 0.05 } }
          ]
        },
        "configurationSelection": { "mode": "bounded_effort", "allowedEfforts": ["high", "xhigh", "max"], "effortChangePolicy": "automatic" },
        "qualityBands": { "artificialAnalysis.intelligenceIndex": 3, "liveBench.reasoning": 3 }
      },
      "review": {
        "strategy": "value_balanced",
        "evidenceRoutes": ["artificialAnalysis.codingIndex", "liveBench.coding"],
        "supportingMetrics": [],
        "qualification": {
          "minimumModels": 2,
          "dimensions": [
            { "key": "reasoning", "evidenceRoutes": ["artificialAnalysis.intelligenceIndex", "liveBench.reasoning"], "qualityBands": { "artificialAnalysis.intelligenceIndex": 3, "liveBench.reasoning": 3 } },
            { "key": "long-context", "evidenceRoutes": ["artificialAnalysisComponents.lcr"], "qualityBands": { "artificialAnalysisComponents.lcr": 0.05 } }
          ]
        },
        "configurationSelection": { "mode": "bounded_effort", "allowedEfforts": ["medium", "high"], "effortChangePolicy": "automatic" },
        "qualityBands": { "artificialAnalysis.codingIndex": 3, "liveBench.coding": 3 }
      },
      "visual-ui": {
        "strategy": "value_balanced",
        "evidenceRoutes": ["artificialAnalysis.codingIndex", "liveBench.coding"],
        "supportingMetrics": [],
        "qualification": {
          "minimumModels": 2,
          "dimensions": [
            { "key": "visual-understanding", "evidenceRoutes": ["artificialAnalysisComponents.mmmuPro"], "qualityBands": { "artificialAnalysisComponents.mmmuPro": 0.03 } }
          ]
        },
        "configurationSelection": { "mode": "bounded_effort", "allowedEfforts": ["medium", "high"], "effortChangePolicy": "automatic" },
        "qualityBands": { "artificialAnalysis.codingIndex": 3, "liveBench.coding": 3 }
      }
    }
  }
}
